# Read-only demo (Vercel). No database, Laravel API, Redis, or Meilisearch.
# Vercel project: root directory `frontend`
# Build command: pnpm prisma generate && pnpm build
# Environment: USE_MOCK_DATA=true and PUBLIC_ENV=production
# Register/login work without Blob (account is kept in an httpOnly cookie).
# For uploads and durable session state on Vercel, create a Blob store.
# Vercel sets BLOB_READ_WRITE_TOKEN. Without that token, local runs use
# frontend/.demo-sessions (or /tmp/demo-sessions on Vercel).
USE_MOCK_DATA=true
PUBLIC_ENV=production
PUBLIC_IMAGE_HOST=

# Full stack (only when MySQL and the Laravel API are available).
# Leave USE_MOCK_DATA unset, then set:
# DATABASE_URL="mysql://root@localhost:3306/arts"
# API_URL=http://127.0.0.1:8000
# PUBLIC_ENV=development
# TRANSLOADIT_KEY=
# TRANSLOADIT_SECRET=
