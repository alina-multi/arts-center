			<name>main</name>
			<translation_urls>
				<translation_url>
					<path>resources/lang/en</path>
					<language>en-US</language>
				</translation_url>
				<translation_url>
					<path>resources/lang/uk</path>
					<language>uk-UA</language>
				</translation_url>
			</translation_urls>
		</translation_package>
