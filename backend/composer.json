{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/stepanorda/html-to-quill"
    },
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    },
    {
      "type": "path",
      "url": "./nova-components/NovaQuill"
    }
  ],
  "require": {
    "php": "^8.4",
    "ably/laravel-broadcaster": "^1.0",
    "arandilopez/laravel-profane": "^0.5.0",
    "darkaonline/l5-swagger": "^8.6",
    "doctrine/dbal": "^4.0",
    "everyday/html-to-quill": "dev-quote",
    "google/cloud-ai-platform": "^0.30.0",
    "google/cloud-translate": "^1.18",
    "intervention/image": "^3.0",
    "itsgoingd/clockwork": "^5.2",
    "laravel/cashier": "^15.4",
    "laravel/framework": "^12.0",
    "laravel/horizon": "^5.28",
    "laravel/nightwatch": "^1.13",
    "laravel/nova": "^5.0",
    "laravel/octane": "^2.8",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^10.0",
    "laravel/socialite": "^5.16",
    "laravel/telescope": "^5.0",
    "laravel/tinker": "^2.10",
    "league/flysystem-aws-s3-v3": "^3.29",
    "meilisearch/meilisearch-php": "^1.10",
    "monarobase/country-list": "^3.2",
    "nadar/quill-delta-parser": "*",
    "nunomaduro/collision": "^8.4",
    "openspout/openspout": "^4.24",
    "pusher/pusher-php-server": "^7.2",
    "sentry/sentry-laravel": "^4.8",
    "spiral/roadrunner-cli": "^2.6",
    "spiral/roadrunner-http": "^3.3",
    "stepanorda/nova-quill": "*",
    "symfony/http-client": "^7.1",
    "symfony/mailgun-mailer": "^7.1",
    "tigroid3/php-imaginary": "^1.03"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel-lang/common": "^6.4",
    "laravel/breeze": "^2.2",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.2",
    "pestphp/pest-plugin-drift": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "phpunit/phpunit": "^11.4",
    "spatie/laravel-ignition": "^2.8"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "http-basic": {
      "nova.laravel.com": {
        "username": "stepanorda87@gmail.com",
        "password": "YB0aINcaivjtRdbRExdSZSFnxlX1XAFTpkcpK7zFZBjcqx9E82"
      }
    },
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "classmap": [
      "database/seeds",
      "database/factories"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-update-cmd": [
      "@php artisan horizon:publish --ansi",
      "@php artisan nova:publish"
    ]
  }
}
